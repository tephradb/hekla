// A named fold is a read model by declaration. Each one is kept for every user and served
// at `GET /folds/UserName?user_id=...` with no projector to write, and folds that share a
// key read together as rows: `GET /rows?folds=UserName,UserWelcomed`.

fold UserName(user_id: Uuid) -> String = "" {
  on @user.registered(user_id) { name } => name
  on @user.renamed(user_id) { name } => name
}

fold UserWelcomed(user_id: Uuid) -> Bool = false {
  on @user.welcomed(user_id) => true
}
