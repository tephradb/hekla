// Shared pure helpers. A module is not a namespace, so this is in scope everywhere in
// the program and the directory is for humans.

fn is_blank(value: String) -> Bool {
  return value.trim().is_empty()
}

// Shared because two commands refuse the same way. Declared once is the point: the code
// a client switches on is derived from the name, so the two cannot drift apart.
refusal InvalidName "name must not be blank"
