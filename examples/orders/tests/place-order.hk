// The command's two slices: the narrow one that makes a repeat a no-op, and the wide
// one that enforces the shop's launch allocation.

test "places an order" {
  run PlaceOrder {
    order_id: "11111111-1111-1111-1111-111111111111",
    customer_id: 7,
    shop_id: 1,
    email: "ada@example.com",
    shipping_address: "1 High St",
    order_total: 25.99,
    notes: "leave with a neighbour",
  }
  expect @order.placed {
    order_id: "11111111-1111-1111-1111-111111111111",
    customer_id: 7,
    shop_id: 1,
    email: "ada@example.com",
    shipping_address: "1 High St",
    order_total: 25.99,
    notes: "leave with a neighbour",
  }
}

// The narrow slice. A caller retrying the same order writes nothing rather than a
// second order, and says so by succeeding.
test "a repeat of the same order writes nothing" {
  given @order.placed {
    order_id: "11111111-1111-1111-1111-111111111111",
    customer_id: 7,
    shop_id: 1,
    email: "ada@example.com",
    shipping_address: "1 High St",
    order_total: 25.99,
    notes: "",
  }
  run PlaceOrder {
    order_id: "11111111-1111-1111-1111-111111111111",
    customer_id: 7,
    shop_id: 1,
    email: "ada@example.com",
    shipping_address: "1 High St",
    order_total: 25.99,
    notes: "",
  }
  expect nothing
}

// The wide slice. Three orders is the allocation, so the fourth is refused however
// many different customers it came from.
test "a shop's launch allocation runs out" {
  given @order.placed {
    order_id: "11111111-1111-1111-1111-111111111111",
    customer_id: 7,
    shop_id: 1,
    email: none,
    shipping_address: none,
    order_total: 10.00,
    notes: "",
  }
  given @order.placed {
    order_id: "22222222-2222-2222-2222-222222222222",
    customer_id: 8,
    shop_id: 1,
    email: none,
    shipping_address: none,
    order_total: 10.00,
    notes: "",
  }
  given @order.placed {
    order_id: "33333333-3333-3333-3333-333333333333",
    customer_id: 9,
    shop_id: 1,
    email: none,
    shipping_address: none,
    order_total: 10.00,
    notes: "",
  }
  run PlaceOrder {
    order_id: "44444444-4444-4444-4444-444444444444",
    customer_id: 10,
    shop_id: 1,
    email: none,
    shipping_address: none,
    order_total: 10.00,
    notes: "",
  }
  expect reject("sold_out", "this shop's launch allocation is gone")
}

// The allocation is per shop, so another shop is unaffected by the first one selling
// out. This is what the wide slice being keyed on `shop_id` buys.
test "another shop has its own allocation" {
  given @order.placed {
    order_id: "11111111-1111-1111-1111-111111111111",
    customer_id: 7,
    shop_id: 1,
    email: none,
    shipping_address: none,
    order_total: 10.00,
    notes: "",
  }
  given @order.placed {
    order_id: "22222222-2222-2222-2222-222222222222",
    customer_id: 8,
    shop_id: 1,
    email: none,
    shipping_address: none,
    order_total: 10.00,
    notes: "",
  }
  given @order.placed {
    order_id: "33333333-3333-3333-3333-333333333333",
    customer_id: 9,
    shop_id: 1,
    email: none,
    shipping_address: none,
    order_total: 10.00,
    notes: "",
  }
  run PlaceOrder {
    order_id: "55555555-5555-5555-5555-555555555555",
    customer_id: 7,
    shop_id: 2,
    email: none,
    shipping_address: none,
    order_total: 10.00,
    notes: "",
  }
  expect @order.placed {
    order_id: "55555555-5555-5555-5555-555555555555",
    customer_id: 7,
    shop_id: 2,
    email: none,
    shipping_address: none,
    order_total: 10.00,
    notes: "",
  }
}
