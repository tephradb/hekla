// The effect crosses the decrypt boundary explicitly. Its state comes from folding the
// log to this event's own position, so the count is a function of the prefix rather
// than of when the handler happened to run.

test "confirms the order to the revealed address" {
  given @order.placed {
    order_id: "11111111-1111-1111-1111-111111111111",
    customer_id: 7,
    shop_id: 1,
    email: "ada@example.com",
    shipping_address: "1 High St",
    order_total: 25.99,
    notes: "",
  }
  respond "https://mail.example/confirm" 200
  deliver NotifyCustomer
  expect http.post("https://mail.example/confirm", {
    "to": "ada@example.com",
    "order_id": "11111111-1111-1111-1111-111111111111",
    "first_order": true,
  })
}

// The fold is inclusive of the trigger, so the second order sees a count of two and
// says so.
test "a repeat customer's confirmation is not their first" {
  given @order.placed {
    order_id: "11111111-1111-1111-1111-111111111111",
    customer_id: 7,
    shop_id: 1,
    email: "ada@example.com",
    shipping_address: "1 High St",
    order_total: 10.00,
    notes: "",
  }
  given @order.placed {
    order_id: "22222222-2222-2222-2222-222222222222",
    customer_id: 7,
    shop_id: 1,
    email: "ada@example.com",
    shipping_address: "1 High St",
    order_total: 10.00,
    notes: "",
  }
  respond "https://mail.example/confirm" 200
  respond "https://mail.example/confirm" 200
  deliver NotifyCustomer
  expect http.post("https://mail.example/confirm", { "first_order": true })
  expect http.post("https://mail.example/confirm", { "first_order": false })
}

test "a rejected confirmation is logged rather than retried forever" {
  given @order.placed {
    order_id: "33333333-3333-3333-3333-333333333333",
    customer_id: 7,
    shop_id: 1,
    email: "ada@example.com",
    shipping_address: "1 High St",
    order_total: 10.00,
    notes: "",
  }
  respond "https://mail.example/confirm" 422
  deliver NotifyCustomer
  expect http.post("https://mail.example/confirm")
  expect log("confirmation rejected with status 422")
}

// Rule 12's terminal skip: the address is gone, so no retry can recover it and the
// invocation is skipped rather than wedging the lane.
test "an erased customer skips rather than sending plaintext" {
  given @order.placed {
    order_id: "44444444-4444-4444-4444-444444444444",
    customer_id: 7,
    shop_id: 1,
    email: "ada@example.com",
    shipping_address: "1 High St",
    order_total: 10.00,
    notes: "",
  }
  erased customer_id "7"
  deliver NotifyCustomer
  expect skipped
}
