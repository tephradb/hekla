// One event carrying two subjects, so each can be erased without touching the other: the
// organisation's commercial figures and the owner's personal ones. Between them the
// sealed fields reach every shape a seal has, because a seal holds text and what that
// text was is the only thing that differs: a scalar, a scalar whose column is a different
// shape from its payload, and the three composites that seal as a JSON document.
//
// Both subject ids stay plaintext, which is how the runtime finds the keys.

event @ticket.opened {
  ticket_id: Uuid,
  org_id: Org,
  owner_id: Owner,
  title: String @max(80),
  priority: Priority,
  due_at: Timestamp,
  fee: Money(2),
  budget: Money(2) @subject(org_id),
  // Optional because an erased subject's column reads back absent, and a type that
  // cannot be absent could not say so.
  contact: String? @subject(owner_id) @max(120),
  // The one sealed kind whose column is a different shape from its payload: a
  // `Timestamp` is epoch micros on the wire and RFC 3339 in a column, so this field's
  // two seals hold different text on purpose. Everything else seals once and reads the
  // same both ways.
  contacted_at: Timestamp @subject(owner_id),
  // A record, a list and a map, each sealed whole. A composite's seal holds the JSON
  // document rule 8 already writes rather than a bare rendering, so all three take one
  // path and the shapes are the only thing that can differ between them. The reporter is
  // the owner's and the other two are the organisation's, so shredding one owner takes a
  // composite and leaves two.
  reporter: Reporter @subject(owner_id),
  watchers: List(String) @subject(org_id),
  labels: Map(String, String) @subject(org_id),
  meta: Json @no_index,
}

event @ticket.retitled { ticket_id: Uuid, title: String @max(80) }

event @ticket.closed { ticket_id: Uuid, org_id: Org }

event @ticket.notified { ticket_id: Uuid }
