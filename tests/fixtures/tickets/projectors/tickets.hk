// One projector reaching every write statement the language has, and every column kind
// a read model can hold.
//
// `budget` and `contact` arrive sealed under different subjects, so the seal propagates
// onto their columns and the projector stores ciphertext without ever seeing plaintext.
// Both columns are optional, because an erased subject's column reads back absent and a
// type that cannot be absent could not say so. Erasing the owner takes `contact` and
// leaves `budget`, which is what a per-field subject buys.

projector Tickets {
  entity Ticket {
    ticket_id: Uuid @key,
    org_id: Int @index,
    owner_id: Int @index,
    title: String @max(80),
    priority: Priority,
    due_at: Timestamp,
    fee: Money(2),
    budget: Money(2)?,
    contact: String? @max(120),
    contacted_at: Timestamp?,
    // Sealed composite columns. Rule 9 propagates a seal onto whichever column
    // receives sealed content, so each of these holds ciphertext of the same JSON
    // document the payload holds. Optional for the reason the two above are.
    reporter: Reporter?,
    watchers: List(String)?,
    labels: Map(String, String)?,
    meta: Json,

    // A compound index, so a scan can ask for one organisation's urgent tickets due
    // this month in one query. `org_id` already carries a single-column index above:
    // this one is the wider question, and the read API picks whichever of them the
    // filter is a prefix of.
    //
    // `due_at` last, because it is the only one of the three a range can run over. An
    // enum sorts by the spelling of its variant rather than by severity, so `priority`
    // takes equality and nothing else. That also makes this index filter-only: an
    // `order_by` over it would sort by that spelling, so the runtime refuses it and
    // leaves it out of the orderings `/openapi.json` enumerates.
    index (org_id, priority, due_at),

    // Which is why this one exists beside it: both columns order, so it can back
    // `?order_by=-by_org_id_due_at` (an organisation's tickets, latest deadline first)
    // as well as filter. The pair is the difference between the two rules in one entity.
    index (org_id, due_at)
  }

  // An `Int @key`, which orders numerically in SQL and lexicographically as text. The
  // two disagree once the keys differ in digit count, and a comparison that walks both
  // orders at once is what `verify::keyed` had to be fixed for.
  entity OrgTotals {
    org_id: Int @key,
    opened: Int,
    closed: Int,
    spend: Money(2),
  }

  on @ticket.opened {
    ticket_id,
    org_id,
    owner_id,
    title,
    priority,
    due_at,
    fee,
    budget,
    contact,
    contacted_at,
    reporter,
    watchers,
    labels,
    meta,
  } {
    put Ticket {
      ticket_id,
      org_id,
      owner_id,
      title,
      priority,
      due_at,
      fee,
      budget,
      contact,
      contacted_at,
      reporter,
      watchers,
      labels,
      meta,
    }
    // `patch`, so the first ticket in an organisation materialises the row from zeros
    // rather than needing one written first.
    patch OrgTotals[org_id] { opened: .opened + 1, spend: .spend + fee }
  }

  // `update`, not `patch`: a retitle of a ticket that never existed is nothing at all,
  // not a ticket with a zeroed everything else.
  on @ticket.retitled { ticket_id, title } {
    update Ticket[ticket_id] { title }
  }

  on @ticket.closed { ticket_id, org_id } {
    delete Ticket[ticket_id]
    patch OrgTotals[org_id] { closed: .closed + 1 }
  }
}
