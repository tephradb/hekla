// `update` on the read model side, so a retitle of a ticket that never existed writes
// nothing rather than materialising a row from zeros.

command RetitleTicket(ticket_id: Uuid, title: String) {
  fold opened = TicketOpened { ticket_id }

  fold closed = TicketClosed { ticket_id }

  if !opened || closed {
    reject NoSuchTicket
  }

  emit @ticket.retitled { ticket_id, title }
}
