// The two propositions every ticket command needs. Named rather than written inline in
// each one, because a fold declares the slice its caller conflicts on: two copies that
// fall out of step give two commands two different boundaries for one question, and no
// test can see it. `in_org` and `notified` stay inline, each being written once.
fold TicketOpened(ticket_id: Uuid) -> Bool = false {
  on @ticket.opened(ticket_id) => true
}

fold TicketClosed(ticket_id: Uuid) -> Bool = false {
  on @ticket.closed(ticket_id) => true
}

// Read models, served from the derived tables rather than a projector. The three sealed
// ones are the owner's personal data kept in a row keyed on the ticket, so no column of
// the row is the owner's id and each cell has to carry it. Between them they are a
// scalar, the one kind whose column form differs from its payload, and a record.
fold TicketContact(ticket_id: Uuid) -> Sealed(String, Owner)? = none {
  on @ticket.opened(ticket_id) { contact } => contact
}

fold TicketContactedAt(ticket_id: Uuid) -> Sealed(Timestamp, Owner)? = none {
  on @ticket.opened(ticket_id) { contacted_at } => contacted_at
}

fold TicketReporter(ticket_id: Uuid) -> Sealed(Reporter, Owner)? = none {
  on @ticket.opened(ticket_id) { reporter } => reporter
}

// Keyed on two subjects, so a read can filter on a leading part of the key.
fold OwnerTickets(org_id: Org, owner_id: Owner) -> tickets: Int @index(org_id) = 0 {
  on @ticket.opened(org_id, owner_id) => tickets + 1
}

// Not stored: `since` is matched by no arm, so the keys it would have cannot be listed.
// A command can still fold it; `/folds/OrgTicketsSince` says why it has nothing to serve.
fold OrgTicketsSince(since: Int, org_id: Org) -> tickets: Int = since {
  on @ticket.opened(org_id) => tickets + 1
}

// Query-only: the arm reads the envelope, so no command may fold it, and it is stored all
// the same. Reading it by name is what it is for.
fold TicketOpenedAt(ticket_id: Uuid) -> Timestamp? = none {
  on @ticket.opened as e (ticket_id) => e.at
}

// Query-only too, for another reason: the month is computed from the record rather than
// carried on it, and a computed key has no form a command's read could ask the log for.
fold OrgTicketsDue(org_id: Org, month: String) -> tickets: Int = 0 {
  on @ticket.opened(org_id) { due_at } key month = month_of(due_at) => tickets + 1
}

fn month_of(at: Timestamp) -> String {
  return "{at.year()}-{at.month().pad(2)}"
}

// Sortable across the whole table, and absent for a ticket still open, which a sort by it
// leaves out.
fold TicketClosedAt(ticket_id: Uuid) -> Timestamp? @index = none {
  on @ticket.closed as e (ticket_id) => e.at
}

// Its arm fires on every ticket and moves the value once, so a history shows one change
// for any number of tickets.
fold OrgHasTickets(org_id: Org) -> Bool = false {
  on @ticket.opened(org_id) => true
}

// A close reaches every owner of the org, which leaves `owner_id` open: a range arm, so
// this fold has no history.
fold OwnerAnyClosed(org_id: Org, owner_id: Owner) -> Bool = false {
  on @ticket.opened(org_id, owner_id) => false
  on @ticket.closed(org_id) => true
}

// Optional with a seed that is not `none`, and an arm that writes the seed back: a history
// that compared the bare seed with the fitted value would report a change that never was.
fold OrgPlan(org_id: Org) -> String? = "free" {
  on @ticket.opened(org_id) => "free"
}

// Ranged: a close reaches every owner of the org.
fold OwnerOrgCloses(org_id: Org, owner_id: Owner) -> n: Int = 0 {
  on @ticket.opened(org_id, owner_id) => n
  on @ticket.closed(org_id) => n + 1
}

// Every arm pins its whole key, but the key is read through a ranged fold, so this has no
// history either: a by-key read would file a ticket under a count the store never held.
fold TicketsByOrgCloses(closes: Int) -> n: Int = 0 {
  on @ticket.opened { org_id, owner_id } key closes = OwnerOrgCloses { org_id, owner_id } => n + 1
}
