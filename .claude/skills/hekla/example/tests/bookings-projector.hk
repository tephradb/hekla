// `project` runs the projector over the seeded log and asserts rows. The row is read
// back through the same seam a handler's `patch` reads through, so a case cannot
// assert on anything the projector itself could not see.

test "a booking becomes a row and loads the room" {
  given @booking.made {
    booking_id: "11111111-1111-1111-1111-111111111111",
    room_id: 12,
    guest_id: 7,
    email: "ada@example.com",
    night: "2026-06-01T00:00:00Z",
    rate: 120.00,
    notes: "",
  }
  project Bookings
  expect Booking["11111111-1111-1111-1111-111111111111"] {
    room_id: 12,
    guest_id: 7,
    email: "ada@example.com",
    confirmed: false,
  }
  expect RoomLoad[12] { booked: 1 }
}

test "a confirmation flips the column" {
  given @booking.made {
    booking_id: "11111111-1111-1111-1111-111111111111",
    room_id: 12,
    guest_id: 7,
    email: "ada@example.com",
    night: "2026-06-01T00:00:00Z",
    rate: 120.00,
    notes: "",
  }
  given @booking.confirmed {
    booking_id: "11111111-1111-1111-1111-111111111111",
  }
  project Bookings
  expect Booking["11111111-1111-1111-1111-111111111111"] { confirmed: true }
}

// `delete` takes the row and the counter comes back down. `expect no` is what makes
// the difference between a row that is gone and one that was never written testable.
test "a cancellation removes the row and frees the room" {
  given @booking.made {
    booking_id: "11111111-1111-1111-1111-111111111111",
    room_id: 12,
    guest_id: 7,
    email: "ada@example.com",
    night: "2026-06-01T00:00:00Z",
    rate: 120.00,
    notes: "",
  }
  given @booking.cancelled {
    booking_id: "11111111-1111-1111-1111-111111111111",
    room_id: 12,
    night: "2026-06-01T00:00:00Z",
  }
  project Bookings
  expect no Booking["11111111-1111-1111-1111-111111111111"]
  expect RoomLoad[12] { booked: 0 }
}
